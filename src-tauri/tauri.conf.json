{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustboard",
  "version": "1.5.1",
  "identifier": "com.rustboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rustboard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["rboard"],
        "name": "Rustboard Board",
        "description": "Rustboard whiteboard",
        "role": "Editor",
        "mimeType": "application/x-rustboard"
      }
    ]
  }
}
